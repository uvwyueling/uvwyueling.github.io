{
  "name": "online-portfolio-2026",
  "private": true,
  "description": "源码在 src/，产物 assets/ 必须提交（GitHub Pages 直接发布仓库，无 CI 构建）",
  "scripts": {
    "build:app": "esbuild src/app.jsx --bundle --minify --format=iife --outfile=assets/app.js",
    "build:echo": "tailwindcss -i src/echo.css -o assets/echo.css --minify",
    "build": "npm run build:app && npm run build:echo"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "3.4.17"
  }
}
